<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>一个小网页3.0</title>
    <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: linear-gradient(145deg, #121826 0%, #0a0e14 100%);
            font-family: 'Segoe UI', 'Inter', system-ui, sans-serif;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 16px;
        }
        .chat-app {
            width: 100%;
            max-width: 1500px;
            height: 90vh;
            background: #f1f5f9;
            border-radius: 28px;
            box-shadow: 0 25px 45px rgba(0, 0, 0, 0.4);
            display: flex;
            overflow: hidden;
        }
        /* 左侧边栏：房间与成员 */
        .sidebar {
            width: 300px;
            background: #ffffff;
            border-right: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }
        .sidebar-header {
            padding: 20px 16px;
            border-bottom: 1px solid #eef2ff;
            background: #fafcff;
        }
        .sidebar-header h3 { font-size: 1.1rem; display: flex; align-items: center; gap: 8px; color: #0f172a; }
        .room-control {
            padding: 16px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }
        .room-control input {
            width: 100%;
            padding: 10px 14px;
            border-radius: 60px;
            border: 1px solid #cbd5e1;
            margin-bottom: 12px;
            font-size: 0.85rem;
        }
        .room-control button {
            width: 100%;
            background: #3b82f6;
            margin-bottom: 8px;
        }
        .member-list {
            flex: 1;
            padding: 12px;
        }
        .member-list h4 {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #64748b;
            margin: 12px 0 8px 8px;
        }
        .member-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            border-radius: 40px;
            margin: 4px 0;
            background: #f1f5f9;
            font-size: 0.85rem;
            font-family: monospace;
        }
        .member-item .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; }
        .member-item.self { background: #e0e7ff; font-weight: 500; }
        .main-chat {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .chat-header {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(12px);
            padding: 14px 24px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .room-name {
            font-weight: 700;
            background: #eef2ff;
            padding: 6px 16px;
            border-radius: 60px;
            font-size: 0.85rem;
        }
        .my-id-badge {
            background: #1e293b;
            color: white;
            padding: 6px 14px;
            border-radius: 60px;
            font-size: 0.7rem;
            font-family: monospace;
        }
        .messages-area {
            flex: 1;
            overflow-y: auto;
            padding: 20px 24px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background: #f1f5f9;
            scroll-behavior: smooth;
        }
        .message {
            display: flex;
            flex-direction: column;
            max-width: 75%;
            animation: fadeInUp 0.2s ease;
        }
        .message.own { align-self: flex-end; }
        .message.other { align-self: flex-start; }
        .bubble {
            padding: 10px 16px;
            border-radius: 24px;
            background: white;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            word-wrap: break-word;
            font-size: 0.95rem;
            line-height: 1.5;
        }
        .message.own .bubble { background: #3b82f6; color: white; border-bottom-right-radius: 4px; }
        .message.other .bubble { background: #ffffff; border-bottom-left-radius: 4px; border: 1px solid #e2e8f0; }
        /* 完整 Markdown 样式 */
        .bubble pre {
            background: #1e293b;
            color: #e2e8f0;
            padding: 12px;
            border-radius: 12px;
            overflow-x: auto;
            margin: 8px 0;
            font-family: 'Fira Code', monospace;
            font-size: 0.85rem;
        }
        .bubble code {
            background: rgba(0,0,0,0.08);
            padding: 2px 6px;
            border-radius: 6px;
            font-family: monospace;
        }
        .message.own .bubble code { background: rgba(255,255,255,0.2); color: white; }
        .bubble h1, .bubble h2, .bubble h3, .bubble h4 { margin: 0.5em 0; }
        .bubble p { margin: 0.3em 0; }
        .bubble a { color: #3b82f6; text-decoration: none; }
        .message.own .bubble a { color: #facc15; }
        .bubble img { max-width: 100%; border-radius: 12px; margin: 4px 0; }
        .bubble ul, .bubble ol { padding-left: 1.5em; margin: 0.5em 0; }
        .bubble blockquote { border-left: 4px solid #3b82f6; margin: 0.5em 0; padding-left: 1em; color: #475569; }
        .bubble table { border-collapse: collapse; width: 100%; margin: 8px 0; }
        .bubble th, .bubble td { border: 1px solid #cbd5e1; padding: 4px 8px; text-align: left; }
        .message-meta {
            font-size: 0.65rem;
            margin: 4px 10px 0;
            display: flex;
            gap: 10px;
            color: #64748b;
        }
        .message.own .message-meta { justify-content: flex-end; }
        .file-preview { margin-top: 8px; border-radius: 16px; max-width: 260px; cursor: pointer; }
        .file-preview img { max-width: 100%; max-height: 180px; border-radius: 12px; }
        .file-attach {
            background: rgba(0,0,0,0.05);
            border-radius: 20px;
            padding: 6px 12px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 6px;
        }
        .input-area {
            background: white;
            border-top: 1px solid #e2e8f0;
            padding: 14px 20px;
            display: flex;
            gap: 12px;
            align-items: center;
        }
        .input-wrapper {
            flex: 1;
            display: flex;
            background: #f1f5f9;
            border-radius: 60px;
            padding: 4px 8px 4px 18px;
            align-items: center;
        }
        .input-wrapper input {
            flex: 1;
            border: none;
            background: transparent;
            padding: 10px 0;
            outline: none;
        }
        .file-buttons label {
            background: #f1f5f9;
            border-radius: 40px;
            padding: 10px 14px;
            cursor: pointer;
            transition: 0.2s;
        }
        button {
            background: #3b82f6;
            border: none;
            padding: 8px 16px;
            border-radius: 40px;
            color: white;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        button:active { transform: scale(0.97);}
        .markdown-hint { font-size: 0.7rem; color: #64748b; margin-left: 8px; }
        /* 右侧历史文件侧边栏 */
        .history-sidebar {
            width: 280px;
            background: white;
            border-left: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }
        .history-header {
            padding: 16px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .clear-history { background: none; color: #ef4444; font-size: 12px; padding: 4px 8px; box-shadow: none; }
        .history-list { flex: 1; padding: 12px; }
        .history-item {
            padding: 10px;
            border-radius: 12px;
            background: #f1f5f9;
            margin-bottom: 8px;
            cursor: pointer;
            font-size: 0.8rem;
        }
        .history-item:hover { background: #e2e8f0; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(8px);} to { opacity: 1; transform: translateY(0);} }
        .progress-overlay {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #1e293b;
            color: white;
            padding: 12px 20px;
            border-radius: 40px;
            z-index: 1000;
            display: flex;
            gap: 12px;
        }
        .progress-bar-bg { width: 150px; height: 6px; background: #334155; border-radius: 10px; overflow: hidden; }
        .progress-bar-fill { width: 0%; height: 100%; background: #3b82f6; }
    </style>
</head>
<body>
<div class="chat-app">
    <div class="sidebar">
        <div class="sidebar-header">
            <h3><i class="fas fa-users"></i> 群聊室 3.0</h3>
            <div class="my-id-badge" style="margin-top: 10px; background:#eef2ff; color:#1e293b;" id="localIdShort">初始化中...</div>
        </div>
        <div class="room-control">
            <input type="text" id="roomIdInput" placeholder="房间号 (例如: tech-room)" autocomplete="off">
            <button id="createOrJoinRoomBtn"><i class="fas fa-door-open"></i> 创建/加入房间</button>
            <button id="leaveRoomBtn" style="background:#64748b;"><i class="fas fa-sign-out-alt"></i> 离开房间</button>
        </div>
        <div class="member-list">
            <h4><i class="fas fa-user-friends"></i> 在线成员 (<span id="memberCount">0</span>)</h4>
            <div id="membersContainer"><div style="padding: 12px; text-align:center; color:gray;">未加入房间</div></div>
            <div id="addMemberWidget" style="display:none; padding:12px; border-top:1px solid #e2e8f0; margin-top:8px;">
                <div style="font-size:12px; margin-bottom:6px;"><i class="fas fa-user-plus"></i> 添加成员 (Peer ID)</div>
                <div style="display:flex; gap:6px;">
                    <input type="text" id="addMemberInput" placeholder="对方Peer ID" style="flex:1; padding:6px; border-radius:40px; border:1px solid #cbd5e1;">
                    <button id="addMemberBtn" style="padding:6px 12px; background:#3b82f6;">添加</button>
                </div>
            </div>
        </div>
    </div>

    <div class="main-chat">
        <div class="chat-header">
            <div class="room-name" id="currentRoomDisplay">🏠 未加入房间</div>
            <div><i class="fas fa-wifi"></i> <span id="connStatusLabel">未连接群组</span></div>
        </div>
        <div class="messages-area" id="messagesContainer">
            <div class="message other"><div class="bubble">✨ <strong>群聊室 3.0 升级版</strong><br>✅ 完整 Markdown (代码块/表格/引用/列表)<br>✅ 房间系统 + 成员自动同步<br>✅ 大文件分块传输 (100MB+)<br>✅ 桌面通知 + 历史文件记录<br>💡 输入房间号加入，分享你的Peer ID给好友，同房间自动组网</div></div>
        </div>
        <div class="input-area">
            <div class="input-wrapper">
                <input type="text" id="messageInput" placeholder="支持完整Markdown：```代码块``` **粗体** > 引用" autocomplete="off">
                <button id="sendMsgBtn"><i class="fas fa-paper-plane"></i></button>
            </div>
            <div class="file-buttons">
                <label for="groupImageUpload" title="发送图片"><i class="fas fa-image"></i></label>
                <input type="file" id="groupImageUpload" accept="image/*" style="display:none">
                <label for="groupFileUpload" title="发送文件"><i class="fas fa-paperclip"></i></label>
                <input type="file" id="groupFileUpload" style="display:none">
            </div>
            <div class="markdown-hint"><i class="fab fa-markdown"></i> Markdown</div>
        </div>
    </div>

    <div class="history-sidebar">
        <div class="history-header"><i class="fas fa-history"></i> 历史文件 <button id="clearHistoryBtn" class="clear-history"><i class="fas fa-trash"></i></button></div>
        <div class="history-list" id="historyList"><div style="color:gray; text-align:center; padding:20px;">暂无文件记录</div></div>
    </div>
</div>

<script>
    // ========== 群聊 3.0 核心 ==========
    const CHUNK_SIZE = 1024 * 1024; // 1MB
    let peer = null;
    let myId = null;
    let currentRoom = null;
    let roomMembers = new Map(); // peerId -> DataConnection
    let receiveBufferMap = new Map(); // 文件接收缓冲
    let fileHistory = []; // 历史文件存储
    
    // 历史文件管理
    function addToHistory(name, url, type, isReceive) {
        fileHistory.unshift({ name, url, type, timestamp: new Date(), isReceive });
        if (fileHistory.length > 100) fileHistory.pop();
        renderHistory();
    }
    function renderHistory() {
        const container = document.getElementById('historyList');
        if (!fileHistory.length) { container.innerHTML = '<div style="color:gray; text-align:center; padding:20px;">暂无文件记录</div>'; return; }
        container.innerHTML = fileHistory.map(f => `
            <div class="history-item" onclick="window.open('${f.url}', '_blank')">
                <i class="fas ${f.type === 'image' ? 'fa-image' : 'fa-file'}"></i>
                <strong>${f.name.substring(0, 22)}</strong><br>
                <small>${f.timestamp.toLocaleTimeString()} ${f.isReceive ? '📥' : '📤'}</small>
            </div>
        `).join('');
    }
    document.getElementById('clearHistoryBtn')?.addEventListener('click', () => { fileHistory = []; renderHistory(); });
    
    // 桌面通知
    let notifyGranted = false;
    if ("Notification" in window) Notification.requestPermission().then(p => notifyGranted = p === "granted");
    function notify(title, body) { if(notifyGranted) new Notification(title, { body }); }
    
    // 完整 Markdown 渲染
    marked.setOptions({ breaks: true, gfm: true });
    function renderMarkdown(text) {
        if (!text) return '';
        try {
            let html = marked.parse(text);
            return DOMPurify.sanitize(html, { ADD_ATTR: ['target'] });
        } catch(e) { return text.replace(/</g, '&lt;'); }
    }
    
    // 添加群聊消息
    function addGroupMessage(senderId, text, extra = null, isSystem = false) {
        const isOwn = (senderId === myId);
        const messageDiv = document.createElement('div');
        messageDiv.className = `message ${isOwn ? 'own' : 'other'}`;
        const bubbleDiv = document.createElement('div');
        bubbleDiv.className = 'bubble';
        if (!isSystem && !isOwn) {
            const label = document.createElement('div');
            label.style.fontSize = '0.7rem';
            label.style.fontWeight = 'bold';
            label.style.opacity = '0.8';
            label.style.marginBottom = '4px';
            label.innerText = `${senderId.substring(0, 8)}...`;
            bubbleDiv.appendChild(label);
        }
        if (extra && extra.type === 'image') {
            const imgDiv = document.createElement('div');
            imgDiv.className = 'file-preview';
            const img = document.createElement('img');
            img.src = extra.url;
            img.onclick = () => window.open(extra.url);
            imgDiv.appendChild(img);
            bubbleDiv.appendChild(imgDiv);
            if (text) bubbleDiv.appendChild(document.createTextNode(text));
            addToHistory(extra.name || '图片', extra.url, 'image', !isOwn);
        } else if (extra && extra.type === 'file') {
            const fileDiv = document.createElement('div');
            fileDiv.className = 'file-attach';
            const link = document.createElement('a');
            link.href = extra.url;
            link.download = extra.name;
            link.textContent = `📎 ${extra.name}`;
            link.target = '_blank';
            fileDiv.appendChild(link);
            bubbleDiv.appendChild(fileDiv);
            if (text) bubbleDiv.appendChild(document.createTextNode(text));
            addToHistory(extra.name, extra.url, 'file', !isOwn);
        } else {
            bubbleDiv.innerHTML = renderMarkdown(text || '');
        }
        messageDiv.appendChild(bubbleDiv);
        const metaSpan = document.createElement('div');
        metaSpan.className = 'message-meta';
        const time = new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
        const displayName = isSystem ? '系统' : (isOwn ? '我' : senderId.substring(0,6));
        metaSpan.innerHTML = `<span>${displayName}</span><span>${time}</span>`;
        messageDiv.appendChild(metaSpan);
        document.getElementById('messagesContainer').appendChild(messageDiv);
        messageDiv.scrollIntoView({ behavior: 'smooth', block: 'end' });
        if (!isOwn && !isSystem && document.hidden) {
            notify('群聊消息', text ? (text.length>40?text.slice(0,40)+'...':text) : '收到文件');
        }
    }
    function addSystemMessage(msg) { addGroupMessage('system', msg, null, true); }
    
    // 广播给房间所有人
    function broadcastToRoom(data, excludeSelf = true) {
        for (let [pid, conn] of roomMembers.entries()) {
            if (excludeSelf && pid === myId) continue;
            if (conn && conn.open) conn.send(data);
        }
    }
    
    // 发送大文件 (分块)
    function sendGroupFile(file, isImage) {
        if (!currentRoom) { addSystemMessage('未加入房间'); return; }
        const fileId = Date.now() + '_' + Math.random().toString(36).substr(2, 8);
        const totalChunks = Math.ceil(file.size / CHUNK_SIZE);
        let currentChunk = 0;
        const sendNext = () => {
            if (currentChunk >= totalChunks) {
                broadcastToRoom({ type: 'file_end', fileId, fileName: file.name, fileSize: file.size, mime: file.type, isImage });
                return;
            }
            const start = currentChunk * CHUNK_SIZE;
            const end = Math.min(start + CHUNK_SIZE, file.size);
            const chunk = file.slice(start, end);
            const reader = new FileReader();
            reader.onload = (ev) => {
                broadcastToRoom({ type: 'file_chunk', fileId, chunkIndex: currentChunk, totalChunks, data: ev.target.result });
                currentChunk++;
                sendNext();
            };
            reader.readAsArrayBuffer(chunk);
        };
        broadcastToRoom({ type: 'file_start', fileId, fileName: file.name, totalChunks, fileSize: file.size, mime: file.type, isImage });
        sendNext();
        const localUrl = URL.createObjectURL(file);
        addGroupMessage(myId, isImage ? `📷 图片: ${file.name}` : `📁 文件: ${file.name}`, 
            { type: isImage ? 'image' : 'file', url: localUrl, name: file.name });
    }
    
    // 发送文本 (Markdown)
    function sendGroupText(text) {
        if (!text.trim()) return;
        if (!currentRoom) { addSystemMessage('未加入房间'); return; }
        const payload = { type: 'group_text', sender: myId, content: text.trim(), timestamp: Date.now() };
        broadcastToRoom(payload);
        addGroupMessage(myId, text.trim());
        document.getElementById('messageInput').value = '';
    }
    
    // 接收数据处理
    function handlePeerMessage(peerId, data) {
        if (!currentRoom) return;
        if (data.type === 'group_text') {
            if (data.sender !== myId) addGroupMessage(data.sender, data.content);
        } else if (data.type === 'file_start') {
            receiveBufferMap.set(data.fileId, { chunks: new Array(data.totalChunks), totalChunks: data.totalChunks, fileName: data.fileName, mime: data.mime, isImage: data.isImage, received: 0, sender: peerId });
        } else if (data.type === 'file_chunk') {
            const entry = receiveBufferMap.get(data.fileId);
            if (entry && !entry.chunks[data.chunkIndex]) {
                entry.chunks[data.chunkIndex] = data.data;
                entry.received++;
                if (entry.received === entry.totalChunks) {
                    const blob = new Blob(entry.chunks, { type: entry.mime });
                    const url = URL.createObjectURL(blob);
                    addGroupMessage(entry.sender, entry.isImage ? `📷 图片: ${entry.fileName}` : `📎 文件: ${entry.fileName}`, 
                        { type: entry.isImage ? 'image' : 'file', url, name: entry.fileName });
                    receiveBufferMap.delete(data.fileId);
                }
            }
        } else if (data.type === 'sync_members_req') {
            const list = Array.from(roomMembers.keys()).concat([myId]);
            if (roomMembers.get(peerId)?.open) {
                roomMembers.get(peerId).send({ type: 'sync_members_resp', list });
            }
        } else if (data.type === 'sync_members_resp') {
            if (data.list && Array.isArray(data.list)) {
                for (let pid of data.list) {
                    if (pid !== myId && !roomMembers.has(pid)) connectToMember(pid);
                }
            }
        }
    }
    
    function connectToMember(remoteId) {
        if (remoteId === myId || roomMembers.has(remoteId)) return;
        const conn = peer.connect(remoteId, { reliable: true });
        setupConnection(conn, remoteId);
    }
    
    function setupConnection(conn, remoteId) {
        conn.on('open', () => {
            if (!roomMembers.has(remoteId)) {
                roomMembers.set(remoteId, conn);
                updateMemberListUI();
                addSystemMessage(`🔗 ${remoteId.substring(0,8)} 加入群聊`);
                conn.send({ type: 'sync_members_req' });
                const myList = Array.from(roomMembers.keys()).concat([myId]);
                conn.send({ type: 'sync_members_resp', list: myList });
            }
        });
        conn.on('data', (data) => handlePeerMessage(remoteId, data));
        conn.on('close', () => {
            if (roomMembers.has(remoteId)) {
                roomMembers.delete(remoteId);
                updateMemberListUI();
                addSystemMessage(`🔌 ${remoteId.substring(0,8)} 离开群聊`);
            }
        });
        conn.on('error', () => {});
    }
    
    function updateMemberListUI() {
        const all = Array.from(roomMembers.keys());
        const total = all.length + 1;
        document.getElementById('memberCount').innerText = total;
        const container = document.getElementById('membersContainer');
        container.innerHTML = '';
        const selfDiv = document.createElement('div');
        selfDiv.className = 'member-item self';
        selfDiv.innerHTML = `<span class="status-dot"></span><span><strong>我</strong> (${myId?.substring(0,8)})</span>`;
        container.appendChild(selfDiv);
        for (let pid of all) {
            const div = document.createElement('div');
            div.className = 'member-item';
            div.innerHTML = `<span class="status-dot"></span><span>${pid.substring(0,10)}...</span>`;
            container.appendChild(div);
        }
        const widget = document.getElementById('addMemberWidget');
        if (widget) widget.style.display = currentRoom ? 'block' : 'none';
    }
    
    function leaveRoom() {
        if (!currentRoom) return;
        for (let [pid, conn] of roomMembers.entries()) { try { conn.close(); } catch(e) {} }
        roomMembers.clear();
        currentRoom = null;
        document.getElementById('currentRoomDisplay').innerText = '🏠 未加入房间';
        document.getElementById('connStatusLabel').innerText = '未连接群组';
        updateMemberListUI();
        addSystemMessage('已离开房间');
    }
    
    function joinRoom(roomName) {
        if (!roomName.trim()) { addSystemMessage('请输入房间号'); return; }
        if (currentRoom === roomName) { addSystemMessage('已在当前房间'); return; }
        if (currentRoom) leaveRoom();
        currentRoom = roomName;
        document.getElementById('currentRoomDisplay').innerText = `🏠 房间: ${roomName}`;
        document.getElementById('connStatusLabel').innerText = `群组 ${roomName} 已激活`;
        addSystemMessage(`✅ 加入房间 "${roomName}"，分享你的Peer ID邀请好友加入`);
        updateMemberListUI();
    }
    
    function addPeerToRoom(remoteId) {
        if (!currentRoom) { addSystemMessage('未加入房间'); return; }
        if (remoteId === myId) { addSystemMessage('不能添加自己'); return; }
        if (roomMembers.has(remoteId)) { addSystemMessage('成员已存在'); return; }
        connectToMember(remoteId);
        addSystemMessage(`尝试连接 ${remoteId.substring(0,8)} ...`);
    }
    
    // 初始化 Peer
    function initPeer() {
        peer = new Peer(undefined, { config: { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] } });
        peer.on('open', (id) => {
            myId = id;
            document.getElementById('localIdShort').innerText = `我的ID: ${id.substring(0,8)}...`;
            addSystemMessage(`✅ 你的Peer ID: ${id}`);
        });
        peer.on('connection', (conn) => {
            if (!currentRoom) {
                conn.on('open', () => { conn.send({ type: 'system', content: '对方未在房间内' }); conn.close(); });
                return;
            }
            if (!roomMembers.has(conn.peer)) setupConnection(conn, conn.peer);
        });
        peer.on('error', (err) => console.error(err));
    }
    
    // UI 绑定
    document.getElementById('createOrJoinRoomBtn').onclick = () => joinRoom(document.getElementById('roomIdInput').value.trim());
    document.getElementById('leaveRoomBtn').onclick = () => leaveRoom();
    document.getElementById('sendMsgBtn').onclick = () => sendGroupText(document.getElementById('messageInput').value);
    document.getElementById('messageInput').onkeypress = (e) => { if(e.key === 'Enter') sendGroupText(e.target.value); };
    document.getElementById('groupImageUpload').onchange = (e) => { if(e.target.files[0]) sendGroupFile(e.target.files[0], true); e.target.value = ''; };
    document.getElementById('groupFileUpload').onchange = (e) => { if(e.target.files[0]) sendGroupFile(e.target.files[0], false); e.target.value = ''; };
    document.getElementById('addMemberBtn')?.addEventListener('click', () => {
        const pid = document.getElementById('addMemberInput').value.trim();
        if(pid) addPeerToRoom(pid);
        document.getElementById('addMemberInput').value = '';
    });
    
    initPeer();
</script>
</body>
</html>
